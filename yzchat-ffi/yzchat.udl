/*
 * yzchat UniFFI Interface Definition
 * Generates Kotlin bindings for the yzchat Rust core
 */

namespace yzchat;

// ============================================
// Crypto Types
// ============================================

record IdentityPublicKey {
    bytes: bytes;
};

record IdentitySecretKey {
    bytes: bytes;
};

record EncryptionPublicKey {
    bytes: bytes;
};

record EncryptionSecretKey {
    bytes: bytes;
};

record PreKey {
    key_id: u32;
    public_key: EncryptionPublicKey;
    signature: bytes;
    timestamp: i64;
};

record SignedPreKey {
    key_id: u32;
    public_key: EncryptionPublicKey;
    signature: bytes;
    timestamp: i64;
};

record KeyBundle {
    identity_key: IdentityPublicKey;
    signed_pre_key: SignedPreKey;
    one_time_pre_keys: list<PreKey>;
    timestamp: i64;
};

record EncryptedMessage {
    message_type: MessageType;
    sender_identity: IdentityPublicKey;
    recipient_identity: IdentityPublicKey;
    timestamp: i64;
    nonce: bytes;
    ciphertext: bytes;
    ratchet_header: optional<RatchetHeader>;
};

record RatchetHeader {
    dh_public: EncryptionPublicKey;
    message_number: u32;
    previous_chain_length: u32;
};

enum MessageType {
    KeyExchange,
    Message,
    GroupMessage,
    CallSignaling,
    FileTransfer,
    Receipt,
    Typing,
    Presence,
};

// ============================================
// P2P Types
// ============================================

record PeerInfo {
    node_id: bytes;  // 32 bytes
    addresses: list<string>;
    aliases: list<string>;
    public_key: bytes;
    last_seen: i64;  // Unix timestamp millis
    is_online: boolean;
    capabilities: PeerCapabilities;
};

record PeerCapabilities {
    supports_voice: boolean;
    supports_video: boolean;
    supports_screen_share: boolean;
    supports_file_transfer: boolean;
    supports_groups: boolean;
    max_video_resolution: VideoResolution;
    supported_codecs: list<string>;
};

enum VideoResolution {
    P720,
    P1080,
    P1440,
    P4K,
    P8K,
};

record ConnectionQuality {
    rtt_ms: u32;
    jitter_ms: u32;
    packet_loss_percent: f32;
    bandwidth_kbps: u32;
    quality_score: f32;
};

record IceCandidate {
    candidate: string;
    sdp_mid: string;
    sdp_mline_index: u32;
    username_fragment: optional<string>;
};

record SdpOffer {
    session_id: string;  // UUID
    from: bytes;         // NodeId
    to: bytes;           // NodeId
    sdp: string;
    timestamp: i64;
};

record SdpAnswer {
    session_id: string;
    from: bytes;
    to: bytes;
    sdp: string;
    timestamp: i64;
};

enum SignalingMessage {
    Offer(SdpOffer),
    Answer(SdpAnswer),
    IceCandidate(IceCandidateMessage),
    End(SessionEnd),
    Reject(SessionReject),
};

record IceCandidateMessage {
    session_id: string;
    from: bytes;
    to: bytes;
    candidate: IceCandidate;
    timestamp: i64;
};

record SessionEnd {
    session_id: string;
    from: bytes;
    to: bytes;
    reason: string;
};

record SessionReject {
    session_id: string;
    from: bytes;
    to: bytes;
    reason: string;
};

// ============================================
// Media Types
// ============================================

enum MediaSessionType {
    VoiceCall,
    VideoCall,
    ScreenShare,
    GroupCall,
};

enum MediaDirection {
    SendOnly,
    RecvOnly,
    SendRecv,
    Inactive,
};

record VideoQuality {
    resolution: (u32, u32);
    framerate: u32;
    bitrate: u32;
    codec: VideoCodec;
    hardware_accel: boolean;
};

record AudioQuality {
    sample_rate: u32;
    channels: u8;
    bitrate: u32;
    codec: AudioCodec;
    echo_cancellation: boolean;
    noise_suppression: boolean;
    auto_gain_control: boolean;
};

record ScreenQuality {
    resolution: (u32, u32);
    framerate: u32;
    bitrate: u32;
    codec: VideoCodec;
    lossless: boolean;
};

record MediaQuality {
    video: VideoQuality;
    audio: AudioQuality;
    screen: ScreenQuality;
};

enum VideoCodec {
    AV1,
    VP9,
    VP8,
    H264,
    H265,
};

enum AudioCodec {
    Opus,
    PCMU,
    PCMA,
    G722,
    ISAC,
    ILBC,
};

enum CallState {
    Idle,
    Connecting,
    Ringing,
    Answering,
    Connected,
    Holding,
    Ending,
    Ended,
    Failed,
};

record CallInfo {
    call_id: string;  // UUID
    session_type: MediaSessionType;
    state: CallState;
    local_user: string;
    remote_user: string;
    started_at: i64;
    connected_at: optional<i64>;
    ended_at: optional<i64>;
    quality: MediaQuality;
    // stats omitted for brevity
};

record MediaConstraints {
    audio: optional<AudioConstraints>;
    video: optional<VideoConstraints>;
    screen: optional<ScreenConstraints>;
};

record AudioConstraints {
    device_id: optional<string>;
    echo_cancellation: optional<boolean>;
    noise_suppression: optional<boolean>;
    auto_gain_control: optional<boolean>;
    sample_rate: optional<u32>;
    channel_count: optional<u8>;
    bitrate: optional<u32>;
};

record VideoConstraints {
    device_id: optional<string>;
    width: optional<(u32, u32)>;
    height: optional<(u32, u32)>;
    framerate: optional<(u32, u32)>;
    facing_mode: optional<string>;
    bitrate: optional<u32>;
    codec: optional<VideoCodec>;
};

record ScreenConstraints {
    width: optional<(u32, u32)>;
    height: optional<(u32, u32)>;
    framerate: optional<(u32, u32)>;
    capture_cursor: optional<boolean>;
    window_id: optional<u32>;
    region: optional<(i32, i32, u32, u32)>;
    bitrate: optional<u32>;
    lossless: optional<boolean>;
};

// ============================================
// Main Interfaces
// ============================================

interface CryptoManager {
    // Identity management
    generate_identity() -> (IdentityPublicKey, IdentitySecretKey);
    export_identity_public(key: IdentitySecretKey) -> IdentityPublicKey;
    export_identity_secret(key: IdentitySecretKey) -> IdentitySecretKey;
    import_identity(public: IdentityPublicKey, secret: IdentitySecretKey) -> IdentitySecretKey;

    // Pre-keys
    generate_pre_keys(count: u32) -> list<PreKey>;
    generate_signed_pre_key(identity: IdentitySecretKey) -> SignedPreKey;
    generate_one_time_pre_keys(count: u32) -> list<PreKey>;
    create_key_bundle(identity: IdentityPublicKey, signed_pre_key: SignedPreKey, one_time_keys: list<PreKey>) -> KeyBundle;

    // Encryption
    encrypt_message(sender_identity: IdentitySecretKey, recipient_bundle: KeyBundle, plaintext: bytes, message_type: MessageType) -> EncryptedMessage;
    decrypt_message(recipient_identity: IdentitySecretKey, message: EncryptedMessage) -> bytes;

    // Signing
    sign_data(identity: IdentitySecretKey, data: bytes) -> bytes;
    verify_signature(public: IdentityPublicKey, data: bytes, signature: bytes) -> boolean;
};

interface P2PManager {
    // Lifecycle
    start(config: P2PConfig) -> void;
    stop() -> void;

    // Identity
    get_node_id() -> bytes;
    get_node_addresses() -> list<string>;

    // Discovery
    discover_peers() -> list<PeerInfo>;
    add_peer(node_id: bytes, addresses: list<string>) -> void;
    get_peer(node_id: bytes) -> optional<PeerInfo>;

    // Connections
    connect(node_id: bytes) -> void;
    disconnect(node_id: bytes) -> void;
    get_connections() -> list<bytes>;

    // Messaging
    send_message(to: bytes, protocol: string, payload: bytes) -> void;
    on_message(callback: MessageCallback) -> void;

    // Signaling
    create_call_session(remote_node: bytes) -> string;  // session_id
    send_offer(session_id: string, offer: SdpOffer) -> void;
    send_answer(session_id: string, answer: SdpAnswer) -> void;
    send_ice_candidate(session_id: string, candidate: IceCandidate) -> void;
    end_call_session(session_id: string, reason: string) -> void;
    on_signaling_message(callback: SignalingCallback) -> void;

    // File transfer
    send_file(peer: bytes, file_path: string, encryption_key: bytes) -> string;  // transfer_id
    receive_file(peer: bytes, blob_hash: string, encryption_key: bytes) -> string;
    get_transfer_progress(transfer_id: string) -> TransferProgress;
    cancel_transfer(transfer_id: string) -> void;
};

record P2PConfig {
    enable_mdns: boolean;
    enable_dht: boolean;
    enable_n0: boolean;
    bootstrap_nodes: list<(bytes, string)>;  // (node_id, address)
    max_connections: u32;
};

record TransferProgress {
    transfer_id: string;
    blob_hash: string;
    total_bytes: u64;
    transferred_bytes: u64;
    status: TransferStatus;
    started_at: i64;
    completed_at: optional<i64>;
};

enum TransferStatus {
    Pending,
    Connecting,
    Downloading,
    Uploading,
    Verifying,
    Completed,
    Failed,
    Cancelled,
};

callback MessageCallback = (from: bytes, protocol: string, payload: bytes) -> void;
callback SignalingCallback = (from: bytes, message: SignalingMessage) -> void;

interface MediaManager {
    // Audio
    start_audio_call(remote_node: bytes, constraints: MediaConstraints) -> string;  // call_id
    stop_audio_call(call_id: string) -> void;
    mute_audio(call_id: string, muted: boolean) -> void;
    set_audio_device(call_id: string, device_id: string) -> void;

    // Video
    start_video_call(remote_node: bytes, constraints: MediaConstraints) -> string;
    stop_video_call(call_id: string) -> void;
    mute_video(call_id: string, muted: boolean) -> void;
    set_video_device(call_id: string, device_id: string) -> void;
    switch_camera(call_id: string, facing_mode: string) -> void;

    // Screen share
    start_screen_share(remote_node: bytes, constraints: MediaConstraints) -> string;
    stop_screen_share(call_id: string) -> void;

    // Incoming calls
    on_incoming_call(callback: IncomingCallCallback) -> void;
    answer_call(call_id: string) -> void;
    reject_call(call_id: string, reason: string) -> void;

    // Devices
    enumerate_audio_devices() -> list<AudioDevice>;
    enumerate_video_devices() -> list<VideoDevice>;

    // Quality
    set_media_quality(call_id: string, quality: MediaQuality) -> void;
    get_media_stats(call_id: string) -> MediaStats;
    on_media_stats(callback: MediaStatsCallback) -> void;
};

record AudioDevice {
    id: string;
    name: string;
    is_input: boolean;
    is_output: boolean;
    is_default: boolean;
    sample_rates: list<u32>;
    channel_counts: list<u8>;
};

record VideoDevice {
    id: string;
    name: string;
    formats: list<VideoFormat>;
    is_default: boolean;
};

record VideoFormat {
    width: u32;
    height: u32;
    framerate: u32;
    format: string;
};

record MediaStats {
    audio: AudioStats;
    video: VideoStats;
    screen: VideoStats;
    connection: ConnectionStats;
};

record AudioStats {
    bytes_sent: u64;
    bytes_received: u64;
    packets_sent: u64;
    packets_received: u64;
    packets_lost: u64;
    jitter_ms: f32;
    rtt_ms: f32;
    bitrate_bps: u32;
    codec: string;
    concealment_events: u32;
};

record VideoStats {
    bytes_sent: u64;
    bytes_received: u64;
    packets_sent: u64;
    packets_received: u64;
    packets_lost: u64;
    jitter_ms: f32;
    rtt_ms: f32;
    bitrate_bps: u32;
    framerate: f32;
    resolution: (u32, u32);
    codec: string;
    frames_encoded: u64;
    frames_decoded: u64;
    frames_dropped: u64;
    encode_time_ms: f32;
    decode_time_ms: f32;
};

record ConnectionStats {
    local_candidate_type: string;
    remote_candidate_type: string;
    transport: string;
    dtls_cipher: string;
    srtp_cipher: string;
    selected_candidate_pair: string;
};

callback IncomingCallCallback = (call_id: string, from: bytes, session_type: MediaSessionType, quality: MediaQuality) -> void;
callback MediaStatsCallback = (call_id: string, stats: MediaStats) -> void;

interface StorageManager {
    // Key storage
    save_identity(key: IdentitySecretKey) -> void;
    load_identity() -> optional<IdentitySecretKey>;
    delete_identity() -> void;

    save_pre_keys(keys: list<PreKey>) -> void;
    load_pre_keys() -> list<PreKey>;
    consume_one_time_pre_key(key_id: u32) -> optional<PreKey>;

    // Message storage
    save_message(message: EncryptedMessage) -> void;
    load_messages(conversation_id: string, limit: u32) -> list<EncryptedMessage>;
    delete_messages(conversation_id: string) -> void;

    // Settings
    save_setting(key: string, value: string) -> void;
    load_setting(key: string) -> optional<string>;
    delete_setting(key: string) -> void;

    // Backup/Restore
    export_backup(password: string) -> bytes;
    import_backup(data: bytes, password: string) -> void;
};

interface YzchatCore {
    // Core initialization
    static new(config: CoreConfig) -> YzchatCore;
    initialize() -> void;
    shutdown() -> void;

    // Sub-managers
    crypto() -> CryptoManager;
    p2p() -> P2PManager;
    media() -> MediaManager;
    storage() -> StorageManager;

    // High-level operations
    register_user(display_name: string) -> IdentityPublicKey;
    login() -> boolean;
    logout() -> void;
    is_logged_in() -> boolean;

    // Contacts
    add_contact(identity: IdentityPublicKey, alias: string) -> void;
    remove_contact(identity: IdentityPublicKey) -> void;
    get_contacts() -> list<Contact>;
    update_contact_alias(identity: IdentityPublicKey, alias: string) -> void;

    // Conversations
    create_conversation(participants: list<IdentityPublicKey>) -> string;  // conversation_id
    send_message(conversation_id: string, text: string) -> void;
    send_file(conversation_id: string, file_path: string) -> void;
    get_messages(conversation_id: string, limit: u32) -> list<Message>;
    mark_read(conversation_id: string, message_id: string) -> void;

    // Groups
    create_group(name: string, members: list<IdentityPublicKey>) -> string;  // group_id
    join_group(invite_link: string) -> void;
    leave_group(group_id: string) -> void;
    get_groups() -> list<Group>;
    send_group_message(group_id: string, text: string) -> void;

    // Calls
    start_call(remote_identity: IdentityPublicKey, session_type: MediaSessionType) -> string;
    answer_call(call_id: string) -> void;
    end_call(call_id: string) -> void;

    // Events
    on_message(callback: MessageEventCallback) -> void;
    on_call(callback: CallEventCallback) -> void;
    on_contact(callback: ContactEventCallback) -> void;
    on_connection_change(callback: ConnectionChangeCallback) -> void;
};

record CoreConfig {
    data_dir: string;
    enable_logging: boolean;
    log_level: string;
    auto_accept_calls: boolean;
    auto_download_media: boolean;
};

record Contact {
    identity: IdentityPublicKey;
    alias: string;
    is_online: boolean;
    last_seen: optional<i64>;
    capabilities: PeerCapabilities;
};

record Message {
    id: string;
    conversation_id: string;
    sender: IdentityPublicKey;
    content: string;  // decrypted text
    message_type: MessageType;
    timestamp: i64;
    is_read: boolean;
    is_delivered: boolean;
    attachments: list<Attachment>;
};

record Attachment {
    id: string;
    filename: string;
    mime_type: string;
    size: u64;
    thumbnail: optional<bytes>;
    blob_hash: string;
};

record Group {
    id: string;
    name: string;
    creator: IdentityPublicKey;
    members: list<GroupMember>;
    created_at: i64;
    updated_at: i64;
};

record GroupMember {
    identity: IdentityPublicKey;
    alias: string;
    role: GroupRole;
    joined_at: i64;
};

enum GroupRole {
    Owner,
    Admin,
    Member,
};

callback MessageEventCallback = (message: Message) -> void;
callback CallEventCallback = (call_id: string, event: CallEvent) -> void;
enum CallEvent {
    Incoming,
    Ringing,
    Connected,
    Ended,
    Failed,
    Muted,
    Unmuted,
}
callback ContactEventCallback = (contact: Contact, event: ContactEvent) -> void;
enum ContactEvent {
    Added,
    Removed,
    Updated,
    Online,
    Offline,
}
callback ConnectionChangeCallback = (connected: boolean, peer_count: u32) -> void;