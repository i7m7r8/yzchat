    <!-- Onboarding -->
    <string name="onboarding_title_1">Quantum-Resistant Security</string>
    <string name="onboarding_desc_1">Your messages are protected with ML-KEM-768 + X25519 hybrid encryption and ML-DSA-65 + Ed25519 signatures. Even quantum computers can\'t break it.</string>
    <string name="onboarding_title_2">True Peer-to-Peer</string>
    <string name="onboarding_desc_2">No servers, no cloud, no metadata collection. Messages travel directly between devices using Iroh\'s QUIC-based P2P network.</string>
    <string name="onboarding_title_3">4K Video Calls</string>
    <string name="onboarding_desc_3">Crystal clear AV1 video at 4K60, Opus audio at 510kbps, and 4K30 screen sharing. All encrypted end-to-end.</string>
    <string name="onboarding_title_4">File Sharing</string>
    <string name="onboarding_desc_4">Send files of any size with streaming transfer, encryption, and resume support. No size limits.</string>
    <string name="onboarding_title_5">Groups & Channels</string>
    <string name="onboarding_desc_5">Create groups with up to 200,000 members. Admin tools, polls, reactions, and more.</string>
    <string name="onboarding_title_6">Your Data, Your Rules</string>
    <string name="onboarding_desc_6">Open source, self-hosted options, local-first storage. You own your keys, your data, your identity.</string>

